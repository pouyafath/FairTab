# ── Local development ──────────────────────────────────────────────────────────
# Path to the SQLite database file (relative to project root)
DATABASE_URL=./fairtab.db

# Directory for uploaded receipts (defaults to ./data/uploads in dev)
# UPLOADS_DIR=./data/uploads

# Public URL of the app (used for PWA manifest and Open Graph)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Self-hosted Docker (set these in docker-compose.yml, not here) ─────────────
# DATABASE_URL=/data/fairtab.db
# UPLOADS_DIR=/data/uploads
# NEXT_PUBLIC_APP_URL=https://yourdomain.com

# ── Access gate (optional) ─────────────────────────────────────────────────────
# When set, every page requires this PIN once per browser (30-day cookie).
# Leave unset for the open LAN behavior. Recommended before exposing the
# instance to the internet. Pick a long passphrase, not a 4-digit code.
# APP_ACCESS_PIN=

# ── Backup token ────────────────────────────────────────────────────────────────
# Required to export (GET /api/backups/export) or restore
# (POST /api/backups/restore) a full JSON backup; both return an error
# response until this is set. Dry-run validation stays open regardless.
# When set, it also protects the recurring-materialization cron hook
# (POST /api/recurring/run); send it as `Authorization: Bearer <token>`.
# FAIRTAB_BACKUP_TOKEN=

# ── Cloudflare Pages ───────────────────────────────────────────────────────────
# No DATABASE_URL needed — D1 is accessed via the CF Workers request context.
# Set NEXT_PUBLIC_APP_URL in the CF Pages dashboard Environment Variables.
