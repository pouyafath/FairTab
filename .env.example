# ── Local development ──────────────────────────────────────────────────────────
# Path to the SQLite database file (relative to project root)
DATABASE_URL=./fairtab.db

# Public URL of the app (used for PWA manifest and Open Graph)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Self-hosted Docker ─────────────────────────────────────────────────────────
# Port binding passed to Docker Compose. Restrict to a specific interface to
# avoid exposing the app on the public NIC.
#   LAN / Tailscale only:  FAIRTAB_PORT_BINDING=100.72.25.41:3000:3000
#   Localhost only (default): FAIRTAB_PORT_BINDING=127.0.0.1:3000:3000
# FAIRTAB_PORT_BINDING=100.72.25.41:3000:3000

# Host path for the persistent data volume (database + uploads).
# Keep this outside the repo so it is never accidentally committed.
# FAIRTAB_DATA_DIR=/srv/data/fairtab

# Public URL shown in the app (set to your Tailscale address or domain).
# NEXT_PUBLIC_APP_URL=http://100.72.25.41:3000

# ── Cloudflare Pages ───────────────────────────────────────────────────────────
# No DATABASE_URL needed — D1 is accessed via the CF Workers request context.
# Set NEXT_PUBLIC_APP_URL in the CF Pages dashboard Environment Variables.
