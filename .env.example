# From your Supabase project: Project Settings -> API (or "Connect").
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The public "publishable" (or "anon") key. Never put the secret/service_role key here.
EXPO_PUBLIC_SUPABASE_KEY=YOUR-PUBLISHABLE-KEY
# Optional: where the web version is hosted, used in invite links (e.g. https://opensplit.app).
EXPO_PUBLIC_WEB_URL=
